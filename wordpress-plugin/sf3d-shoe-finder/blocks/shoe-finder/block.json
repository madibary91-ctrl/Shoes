{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "sf3d/shoe-finder",
  "title": "SF3D Shoe Finder",
  "category": "widgets",
  "icon": "products",
  "description": "شبکه‌ی سه‌بعدی محصولات ووکامرس.",
  "keywords": ["shoe", "woocommerce", "3d", "کفش"],
  "textdomain": "sf3d-shoe-finder",
  "supports": { "html": false, "align": ["wide", "full"] },
  "editorScript": "sf3d-block-editor",
  "attributes": {
    "title": { "type": "string", "default": "" },
    "limit": { "type": "number", "default": 60 },
    "categories": { "type": "string", "default": "" },
    "orderby": { "type": "string", "default": "date" },
    "order": { "type": "string", "default": "DESC" },
    "only_in_stock": { "type": "boolean", "default": false },
    "height": { "type": "string", "default": "100vh" },
    "columns": { "type": "number", "default": 8 },
    "item_size": { "type": "number", "default": 2.5 },
    "gap": { "type": "number", "default": 0.4 },
    "theme": { "type": "string", "default": "auto" },
    "card_position": { "type": "string", "default": "end" },
    "start_collection": { "type": "string", "default": "all" },
    "wishlist": { "type": "boolean", "default": true },
    "quick_actions": { "type": "boolean", "default": true },
    "badges": { "type": "boolean", "default": true },
    "gallery": { "type": "boolean", "default": true },
    "related": { "type": "boolean", "default": true },
    "search": { "type": "boolean", "default": true },
    "dark_mode": { "type": "boolean", "default": true },
    "filters": { "type": "boolean", "default": true },
    "sort": { "type": "boolean", "default": true },
    "bulk": { "type": "boolean", "default": true },
    "recent": { "type": "boolean", "default": true },
    "cart_drawer": { "type": "boolean", "default": true },
    "minimap": { "type": "boolean", "default": true },
    "hash_sync": { "type": "boolean", "default": true }
  }
}
